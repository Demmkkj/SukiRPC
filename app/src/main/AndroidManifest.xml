        <receiver android:name=".WatchingWidget" android:label="Now Watching" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/suki_widget_info"/></receiver>
        <receiver android:name=".DeviceWidget" android:label="SukiRPC Devices" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/suki_widget_info"/></receiver>
