    <queries><package android:name="com.discord"/><package android:name="com.nuvio.app"/><package android:name="com.nuviodebug.com"/><package android:name="com.nuvio.tv"/><package android:name="com.stremio.one"/><package android:name="org.jellyfin.mobile"/><package android:name="org.jellyfin.androidtv"/><package android:name="com.plexapp.android"/><package android:name="org.xbmc.kodi"/><package android:name="org.videolan.vlc"/><package android:name="is.xyz.mpv"/><package android:name="com.spotify.music"/><package android:name="com.spotify.tv.android"/><package android:name="com.google.android.youtube"/><package android:name="com.google.android.youtube.tv"/><package android:name="com.google.android.apps.youtube.music"/></queries>
    <application android:name=".AuroraApplication" android:allowBackup="false" android:label="SukiRPC" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false" android:icon="@mipmap/suki_launcher" android:roundIcon="@mipmap/suki_launcher">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.SukiRPC.Eclipse.Starting"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <activity android:name=".ControlActivity" android:exported="false" android:theme="@style/Theme.SukiRPC.Eclipse.Starting"/>
